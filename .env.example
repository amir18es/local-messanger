# PostgreSQL connection string. Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/local_messenger

# Generate a unique random secret (at least 32 characters). Never commit it.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# The first admin user is created only if this username does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
ADMIN_DISPLAY_NAME=مدیر سیستم

# Optional. In production, set this to the public origin with no trailing slash.
# Example: https://your-messenger.onrender.com
APP_ORIGIN=

# Set production in hosted environments. In local development use development.
NODE_ENV=development
PORT=3000
UPLOAD_DIR=./uploads
MAX_FILE_MB=15
